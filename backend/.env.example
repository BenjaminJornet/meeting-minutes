# =============================================================================
# Meeting Minutes (Meetily) - Docker Environment Configuration
# =============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Compose Project Name
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=meeting-minutes

# -----------------------------------------------------------------------------
# GPU Configuration (NVIDIA CUDA)
# -----------------------------------------------------------------------------
# Use GPU Dockerfile (requires NVIDIA GPU + Docker with nvidia-container-toolkit)
# For CPU-only: DOCKERFILE=Dockerfile.server-cpu and TAG=cpu
DOCKERFILE=Dockerfile.server-gpu
TAG=gpu
CUDA_VERSION=12.3.1
UBUNTU_VERSION=22.04

# -----------------------------------------------------------------------------
# Whisper Server Configuration
# -----------------------------------------------------------------------------
# Available models: tiny, base, small, medium, large, large-v2, large-v3
# Larger models = better accuracy but slower and more VRAM
# - tiny:    ~75MB  - fastest, least accurate
# - base:   ~150MB  - good for quick tests
# - small:  ~500MB  - balanced speed/accuracy
# - medium:   ~1.5GB - high accuracy
# - large-v3: ~3GB   - best accuracy (recommended for GPU)
WHISPER_MODEL=models/ggml-large-v3.bin

# Language for transcription (use 'auto' for auto-detection)
# Common codes: en, fr, de, es, it, pt, zh, ja, ko
WHISPER_LANGUAGE=fr

# Enable GPU acceleration (requires NVIDIA GPU)
WHISPER_USE_GPU=true

# Number of threads (0 = auto-detect based on CPU cores)
WHISPER_THREADS=8

# Enable translation to English
WHISPER_TRANSLATE=false

# Enable speaker diarization (experimental)
WHISPER_DIARIZE=false

# Print progress during transcription
WHISPER_PRINT_PROGRESS=true

# -----------------------------------------------------------------------------
# Service Ports
# -----------------------------------------------------------------------------
WHISPER_PORT=8178
APP_PORT=5167

# -----------------------------------------------------------------------------
# Ollama Configuration (for LLM-based summaries)
# -----------------------------------------------------------------------------
# Use host.docker.internal to access Ollama running on host machine
# For remote Ollama: http://<tailscale-ip>:11434
OLLAMA_HOST=http://host.docker.internal:11434

# -----------------------------------------------------------------------------
# API Keys (Optional - for cloud LLM providers)
# -----------------------------------------------------------------------------
# Leave empty if using Ollama (recommended for privacy)
# Uncomment and fill in if using cloud providers
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=

# -----------------------------------------------------------------------------
# Optional: Local directories (usually not needed)
# -----------------------------------------------------------------------------
# LOCAL_MODELS_DIR=./models
# CONFIG_DIR=./config
# LOCAL_ENV_FILE=./app/.env
