# =============================================================================
# Meetily Frontend Environment Configuration
# =============================================================================
# Copy this file to .env and configure for your setup
# The app will automatically load these variables on startup
# =============================================================================

# -----------------------------------------------------------------------------
# Backend FastAPI URL
# -----------------------------------------------------------------------------
# The URL where the Meetily backend (FastAPI) is running
# Default: http://localhost:5167
#
# For REMOTE backend (e.g., Windows server via Tailscale):
#   MEETILY_BACKEND_URL=http://100.64.0.4:5167
#
# For LOCAL development:
#   MEETILY_BACKEND_URL=http://localhost:5167
# -----------------------------------------------------------------------------
MEETILY_BACKEND_URL=http://localhost:5167

# -----------------------------------------------------------------------------
# Ollama URL (for AI summaries)
# -----------------------------------------------------------------------------
# The URL where Ollama is running for generating meeting summaries
# Default: http://localhost:11434
#
# For REMOTE Ollama (e.g., on a GPU server via Tailscale):
#   MEETILY_OLLAMA_URL=http://100.64.0.4:11434
#
# NOTE: This can also be configured in the app's Settings UI
# -----------------------------------------------------------------------------
MEETILY_OLLAMA_URL=http://localhost:11434

# =============================================================================
# TRANSCRIPTION CONFIGURATION
# =============================================================================
# The desktop app supports multiple transcription options:
#
# 1. LOCAL WHISPER (Recommended for Mac):
#    - Uses Metal/CoreML acceleration on Apple Silicon
#    - No network latency - instant transcription
#    - Privacy: audio never leaves your machine
#    - Download models from Settings → Transcription
#
# 2. REMOTE WHISPER (For GPU servers):
#    - Sends audio to a remote whisper.cpp server
#    - Best for using powerful GPU like RTX 4090
#    - Configure URL in Settings → Transcription → Remote Whisper
#
# 3. PARAKEET (Fast real-time):
#    - Optimized for Apple Silicon
#    - Great for real-time transcription
# =============================================================================

# -----------------------------------------------------------------------------
# Remote Whisper Server URL (Default fallback)
# -----------------------------------------------------------------------------
# This is the DEFAULT URL used when "Remote Whisper" is selected in Settings
# if no custom URL is configured in the UI.
#
# The whisper-server can be started with:
#   ./whisper-server -m models/ggml-large-v3.bin --host 0.0.0.0 --port 8178
#
# For REMOTE whisper server (e.g., via Tailscale):
#   MEETILY_WHISPER_URL=http://100.64.0.4:8178
#
# For LOCAL whisper server:
#   MEETILY_WHISPER_URL=http://localhost:8178
# -----------------------------------------------------------------------------
# MEETILY_WHISPER_URL=http://localhost:8178

# -----------------------------------------------------------------------------
# Language / Locale Settings
# -----------------------------------------------------------------------------
# Default language for the app UI and templates
# Supported values: en, fr
# Default: en
# MEETILY_LANGUAGE=en